# Environment Configuration for Savelo Centralized IdP

# PostgreSQL connection string (Docker default port 5433 mapped to avoid conflict)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/savelo_idp?schema=public"

# Redis connection string
REDIS_URL="redis://localhost:6379"

# Server Secret Pepper for OTP HMAC-SHA256 (Keep this extremely secure)
AUTH_PEPPER_SECRET="super-secret-pepper-change-in-production-min-32-chars-long"

# IdP Public Base URL (Used as JWT Issuer 'iss' and for OIDC Discovery)
IDP_ISSUER_URL="http://localhost:3000"

# RS256 RSA Keypair for JWT signing and JWKS.
# If left empty in development, the system will auto-generate an ephemeral keypair in memory.
# In production, provide PEM-formatted strings or base64 encoded strings.
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_KEY_ID="savelo-idp-key-1"

# Cookie Configuration
COOKIE_NAME="savelo_session"
COOKIE_DOMAIN="" # Leave empty for localhost, or e.g. ".savelo.web.id"